{
  "manifest_version": 3,
  "name": "Roadster 决策驾驶员",
  "description": "使用 StartLux / System One 兼容接口实时异步驾驶 Roadster Rush，显示真实模型、响应耗时和当前指令。",
  "version": "0.4.4",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://roadster-rush.ai.studio/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Roadster 决策驾驶员"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
